# Environment for docker-compose.unraid.yml (Hearth on Unraid).
# Copy this file to `.env` next to the compose file and adjust the values.
# Media mounts and the database path are set directly in the compose file.

# Set your timezone; pick a TZ identifier from https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
# America/New_York is US Eastern time (equivalent to EST5EDT), with daylight saving handled automatically.
TZ=America/New_York

# The image tag of this fork to run. Pin to a release tag (e.g. v1.1.0) for
# reproducible upgrades; "main" tracks the latest merged build instead.
IMMICH_VERSION=v1.1.0

# Connection secret for postgres. You should change it to a random password
# Please use only the characters `A-Za-z0-9`, without special characters or spaces
DB_PASSWORD=postgres

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
