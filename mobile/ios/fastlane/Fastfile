# Hearth ships to the family through TestFlight from a personal Apple
# Developer team. Signing is Xcode-automatic: the first run registers the
# bundle IDs, the app group and capabilities on the team, and Xcode manages
# provisioning profiles from then on (-allowProvisioningUpdates).
#
# Team/bundle/group identifiers live in ../Signing.xcconfig, which the Xcode
# project reads for every target — change them there, not here.
#
# See mobile/TESTFLIGHT.md for the full zero-to-TestFlight walkthrough.

default_platform(:ios)

platform :ios do
  BUNDLE_ID = "com.lordblight.hearth"

  # Optional App Store Connect API key — avoids Apple ID 2FA prompts.
  # Create one under App Store Connect -> Users and Access -> Integrations,
  # save it as ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8 and export
  # APP_STORE_CONNECT_API_KEY_ID and APP_STORE_CONNECT_API_KEY_ISSUER_ID.
  # Without it, fastlane falls back to interactive Apple ID sign-in.
  def api_key_if_configured
    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    return nil unless key_id

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_filepath: "#{Dir.home}/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8",
      duration: 1200,
      in_house: false
    )
  end

  # Writes the version and build number onto EVERY target. App Store Connect
  # rejects an upload whose extensions don't carry byte-identical
  # CFBundleVersion / CFBundleShortVersionString values to the parent app
  # (ITMS-90473), and the extensions generate their Info.plist from these
  # build settings while Runner/Info.plist reads the same two variables — so
  # stamping all targets keeps the whole bundle in lockstep by construction.
  def stamp_all_targets(version:, build_number:)
    require 'xcodeproj'

    project = Xcodeproj::Project.open("./Runner.xcodeproj")
    project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings["MARKETING_VERSION"] = version
        config.build_settings["CURRENT_PROJECT_VERSION"] = build_number.to_s
      end
    end
    project.save

    UI.success("Stamped #{version} (#{build_number}) on: #{project.targets.map(&:name).join(', ')}")
  end

  # The app target's current build number, for lanes that don't bump it.
  def current_build_number
    require 'xcodeproj'

    project = Xcodeproj::Project.open("./Runner.xcodeproj")
    runner = project.targets.find { |t| t.name == "Runner" }
    runner.build_configurations.first.build_settings["CURRENT_PROJECT_VERSION"] || "1"
  end

  # The marketing version always comes from pubspec.yaml (single source of
  # truth shared with Android); the build number comes from TestFlight.
  def get_version_from_pubspec
    require 'yaml'

    pubspec_path = File.join(Dir.pwd, "../..", "pubspec.yaml")
    pubspec = YAML.load_file(pubspec_path)

    version_string = pubspec['version']
    version_string ? version_string.split('+').first.split('-').first : nil
  end

  desc "Build Hearth and upload it to TestFlight"
  lane :release do
    api_key = api_key_if_configured

    update_code_signing_settings(
      use_automatic_signing: true,
      path: "./Runner.xcodeproj",
      targets: ["Runner", "ShareExtension", "WidgetExtension"]
    )

    stamp_all_targets(
      version: get_version_from_pubspec,
      build_number: latest_testflight_build_number(
        api_key: api_key,
        app_identifier: BUNDLE_ID,
        initial_build_number: 0 # first-ever upload becomes build 1
      ) + 1
    )

    gym(
      scheme: "Runner",
      workspace: "Runner.xcworkspace",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-skipMacroValidation -allowProvisioningUpdates",
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        uploadSymbols: true,
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build only (sanity-check signing without uploading)"
  lane :build_only do
    # Same stamp as release, reusing the current build number so this lane
    # needs no App Store Connect access.
    stamp_all_targets(version: get_version_from_pubspec, build_number: current_build_number)

    update_code_signing_settings(
      use_automatic_signing: true,
      path: "./Runner.xcodeproj",
      targets: ["Runner", "ShareExtension", "WidgetExtension"]
    )

    gym(
      scheme: "Runner",
      workspace: "Runner.xcworkspace",
      configuration: "Release",
      export_method: "app-store",
      skip_package_ipa: true,
      xcargs: "-skipMacroValidation -allowProvisioningUpdates",
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
      }
    )
  end
end
